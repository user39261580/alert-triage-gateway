# Docker Compose (used by docker-compose.yml)
POSTGRES_DB=infra_ops
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret

HDX_API_KEY=local-dev-key

LANGFUSE_DB_SCHEMA=langfuse
LANGFUSE_NEXTAUTH_SECRET=langfuse_nextauth_secret_changeme
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_SALT=langfuse_salt_changeme
LANGFUSE_ENCRYPTION_KEY=replace_with_64_hex_chars

# App runtime values (not provided in .env above)
# TODO_FILL: Set these before calling the real OpenAI/Langfuse APIs.
OPENAI_API_KEY=__TODO_FILL_ME__
LANGFUSE_PUBLIC_KEY=__TODO_FILL_ME__
LANGFUSE_SECRET_KEY=__TODO_FILL_ME__
LANGFUSE_HOST=http://localhost:3000

# TODO_FILL: Keep this as app DB connection string for local app execution.
DATABASE_URL=postgresql://admin:secret@localhost:5432/infra_ops

OTEL_SERVICE_NAME=alert-triage-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
